# Local-only development credentials. Do not use these passwords outside local Docker.
URI_DATABASE_URL=postgresql+psycopg://uri:uri_dev_local@127.0.0.1:55440/uri
# Local-only test credential. The test suite reads URI_TEST_DATABASE_URL explicitly.
URI_TEST_DATABASE_URL=postgresql+psycopg://uri:uri_test_local@127.0.0.1:55441/uri_test
URI_PILOT_MODE=true
# Default storage: backend/.local/artifacts and backend/.local/staging.
# Set absolute URI_ARTIFACT_ROOT and URI_STAGING_ROOT to relocate local storage.
URI_JOB_LEASE_SECONDS=30
URI_JOB_POLL_INTERVAL_SECONDS=1
URI_JOB_HEARTBEAT_INTERVAL_SECONDS=10
URI_JOB_MAX_ATTEMPTS=3
